# Copy to backend/.env (local) or set in your host. Placeholders only - never commit real values.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=40
MAX_BATCH_FILES=10
JOB_TIMEOUT_SECONDS=300
RETENTION_MINUTES=60
MAX_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=20
OCR_LANG=eng
OCR_DPI=300
# Windows, if tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# JOBS_DIR=/data/jobs
